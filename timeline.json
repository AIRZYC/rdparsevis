{
  "rules": [
    {
      "name": "expr",
      "text": "expr -> expr + term | expr - term | term",
      "raw_matches": [
        "match(:expr, \"+\", :term)",
        "match(:expr, \"-\", :term)",
        "match(:term)"
      ]
    },
    {
      "name": "term",
      "text": "term -> term * dice | term / dice | dice",
      "raw_matches": [
        "match(:term, \"*\", :dice)",
        "match(:term, \"/\", :dice)",
        "match(:dice)"
      ]
    },
    {
      "name": "dice",
      "text": "dice -> atom d sides | atom",
      "raw_matches": [
        "match(:atom, \"d\", :sides)",
        "match(:atom)"
      ]
    },
    {
      "name": "sides",
      "text": "sides -> % | atom",
      "raw_matches": [
        "match(\"%\")",
        "match(:atom)"
      ]
    },
    {
      "name": "atom",
      "text": "atom -> Integer | ( expr )",
      "raw_matches": [
        "match(Integer)",
        "match(\"(\", :expr, \")\")"
      ]
    }
  ],
